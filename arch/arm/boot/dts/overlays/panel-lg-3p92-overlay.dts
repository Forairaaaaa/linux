/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "raspberrypi,5-model-b","brcm,bcm2712";
	
	fragment@0 {
		target = <&i2c_csi_dsi0>;
		__overlay__ {
			// status = "disabled";
            status = "okay";
            #address-cells = <1>;
	        #size-cells = <0>;

			sw42000_sub: sw42000_sub@28 {
				status = "okay";
				compatible = "lge_sub,sw42000_sub";
				reg = <0x28>;
				
				interrupt-parent = <&gpio>;
				interrupts = <17 IRQ_TYPE_LEVEL_LOW>; // TODO
				reset-gpios = <&gpio 27 GPIO_ACTIVE_LOW>;  // TODO

				/* Caps */
				max_x = <1080>;
				max_y = <1240>;
				max_pressure = <0xff>;
				max_width_major = <1080>;
				max_width_minor = <1240>;
				max_orientation = <90>;
				max_id = <10>;
				hw_reset_delay = <40>;
				sw_reset_delay = <40>;

				/* role */
				use_lpwg = <1>;
				use_lpwg_test = <1>;
				hide_coordinate = <1>;
				use_activepen_status = <0>;
				use_film_status = <1>;
				use_dex_mode = <1>;

				/* Firmware */
				fw_image = "touch/winglm/V1W39WING_v0.18.img";
				panel_spec = "touch/winglm/wing_sw42000_limit.txt";
				panel_spec_mfts_folder = "touch/winglm/wing_sw42000_limit.txt";
			};
		};
	};
	
	dsi_frag: fragment@1 {
		target = <&dsi0>;
		__overlay__{
            #address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port {
				rpi_dsi_out_port:endpoint {
					remote-endpoint = <&rpi_dsi_port>;
				};
			};
			
			panel_disp:panel_disp@0 {
				reg = <0>;
				compatible = "lg,lg3p92";
				status = "okay";
                reset-gpios = <&gpio 22 GPIO_ACTIVE_LOW>; // TODO
				port {
					rpi_dsi_port: endpoint {
						remote-endpoint = <&rpi_dsi_out_port>;
					};
				};
			};
		};
	};

    __overrides__ {
        // TODO
		dsi1 = <&dsi_frag>, "target:0=",<&dsi1>;
        io_disp_rst = <&panel_disp>, "reset-gpios:1";
	};
};
