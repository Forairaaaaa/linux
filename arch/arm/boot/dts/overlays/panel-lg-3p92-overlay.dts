/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "raspberrypi,5-model-b","brcm,bcm2712";
	
	fragment@0 {
		target = <&i2c_csi_dsi0>;
		__overlay__ {
			status = "disabled";
		};
	};
	
	dsi_frag: fragment@1 {
		target = <&dsi0>;
		__overlay__{
            #address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port {
				rpi_dsi_out_port:endpoint {
					remote-endpoint = <&rpi_dsi_port>;
				};
			};
			
			panel_disp:panel_disp@0 {
				reg = <0>;
				compatible = "lg,lg3p92";
				status = "okay";
                reset-gpios = <&gpio 25 GPIO_ACTIVE_LOW>; // TODO
				port {
					rpi_dsi_port: endpoint {
						remote-endpoint = <&rpi_dsi_out_port>;
					};
				};
			};
		};
	};

    __overrides__ {
        // TODO
		dsi1 = <&dsi_frag>, "target:0=",<&dsi1>;
        io_disp_rst = <&panel_disp>, "reset-gpios:1";
	};
};
